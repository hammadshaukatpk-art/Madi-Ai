   <Button Style="{StaticResource TileButton}" Content="◉&#10;WhatsApp" Click="Whatsapp_Click"/>
   <Button Style="{StaticResource TileButton}" Content="◈&#10;eBay" Click="Ebay_Click"/>
   <Button Style="{StaticResource TileButton}" Content="🛒&#10;AliExpress" Click="Ali_Click"/>
   <Button Style="{StaticResource TileButton}" Content="▥&#10;MT5" Click="Mt5_Click"/>
   <Button Style="{StaticResource TileButton}" Content="◉&#10;Canva" Click="Canva_Click"/>
   <Button Style="{StaticResource TileButton}" Content="▣&#10;Office" Click="Office_Click"/>
   <Button Style="{StaticResource TileButton}" Content="◎&#10;ChatGPT" Click="Chat_Click"/>
   <Button Style="{StaticResource TileButton}" Content="＋&#10;Add" Click="Apps_Click"/>
