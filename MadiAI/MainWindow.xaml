    <Button Style="{StaticResource TileButton}" Content="▣&#10;Open App" Click="Apps_Click"/>
    <Button Style="{StaticResource TileButton}" Content="⌕&#10;Search" Click="Web_Click"/>
    <Button Style="{StaticResource TileButton}" Content="▦&#10;Calculate" Click="Calc_Click"/>
