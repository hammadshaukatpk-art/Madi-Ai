    <ComboBoxItem Content="🌐 Auto"/><ComboBoxItem Content="🇺🇸 English"/><ComboBoxItem Content="🇵🇰 اردو"/><ComboBoxItem Content="🇮🇳 हिन्दी"/>
   </ComboBox>
   <Button x:Name="StartVoiceButton" Width="74" Content="START" Background="#145A88" Foreground="White" FontWeight="Bold" BorderBrush="#26DFFF" Click="Voice_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button Width="43" Content="—" FontSize="18" Background="Transparent" Foreground="White" BorderThickness="0" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button Width="43" Content="□" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button Width="43" Content="×" FontSize="25" Background="#331324" Foreground="#FFB4BD" BorderThickness="0" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
  </StackPanel>
 </Canvas>
 <Grid x:Name="GateOverlay" Background="#F8030C1A">
  <Border Width="550" Height="365" Background="#091C33" BorderBrush="#22C9FF" BorderThickness="2" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
   <StackPanel Margin="38,24">
    <Image Source="/madi.png" Width="100" Height="100" HorizontalAlignment="Center"/>
    <TextBlock Text="MADI AI • SECURE ACCESS" FontSize="23" FontWeight="Bold" Foreground="#57DFFF" HorizontalAlignment="Center" Margin="0,10"/>
    <TextBlock x:Name="GatePrompt" Text="Tell me your secret code to open me" FontSize="16" HorizontalAlignment="Center" Margin="0,7"/>
    <PasswordBox x:Name="SecretBox" Height="40" Background="#0C2944" Foreground="White" BorderBrush="#39D3FF" FontSize="19" Margin="0,10" KeyDown="SecretBox_KeyDown"/>
    <Button Content="UNLOCK MADI AI" Height="42" Background="#135D95" Foreground="White" FontWeight="Bold" Click="Unlock_Click" Cursor="Hand"/>
    <TextBlock x:Name="GateHelp" Text="Your code is saved locally, not in GitHub." Foreground="#8EAEC6" FontSize="12" Margin="0,10" TextAlignment="Center"/>
   </StackPanel>
  </Border>
 </Grid>
</Grid>
</Viewbox>
</Window>
